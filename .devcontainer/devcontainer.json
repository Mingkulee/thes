{
  "name": "thes — Telegram Multi-Agent Bot",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install --user -r requirements.txt",
  "postAttachCommand": "bash .devcontainer/welcome.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  },
  "containerEnv": {
    "TELEGRAM_BOT_TOKEN": "${localEnv:TELEGRAM_BOT_TOKEN}",
    "TELEGRAM_BOT_TOKEN_TRANSLATOR": "${localEnv:TELEGRAM_BOT_TOKEN_TRANSLATOR}",
    "TELEGRAM_BOT_TOKEN_CODER": "${localEnv:TELEGRAM_BOT_TOKEN_CODER}",
    "TELEGRAM_BOT_TOKEN_RESEARCHER": "${localEnv:TELEGRAM_BOT_TOKEN_RESEARCHER}",
    "TELEGRAM_BOT_TOKEN_WEATHER": "${localEnv:TELEGRAM_BOT_TOKEN_WEATHER}",
    "GOOGLE_API_KEY": "${localEnv:GOOGLE_API_KEY}"
  }
}
