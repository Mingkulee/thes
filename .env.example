# Telegram Bot credentials
# Get tokens from @BotFather on Telegram: https://t.me/BotFather

# Orchestrator bot (required) — routes messages to the right specialist automatically.
TELEGRAM_BOT_TOKEN=your-orchestrator-bot-token-here

# Specialist bots (all optional) — each goes directly to its dedicated agent.
# Only bots with a token set here will run.
TELEGRAM_BOT_TOKEN_TRANSLATOR=
TELEGRAM_BOT_TOKEN_CODER=
TELEGRAM_BOT_TOKEN_RESEARCHER=
TELEGRAM_BOT_TOKEN_WEATHER=
TELEGRAM_BOT_TOKEN_DOCANALYST=

# Google Gemini API key (required)
# Get one from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here
